<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:orientation="horizontal"
            android:background="#E94560"
            android:padding="12dp"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="طابعات المسار"
                android:textColor="#FFFFFF"
                android:textSize="22sp"
                android:textStyle="bold"
                android:gravity="end"/>

            <Button
                android:id="@+id/btnAbout"
                android:layout_width="80dp"
                android:layout_height="40dp"
                android:text="عن"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"/>

            <Button
                android:id="@+id/btnSettings"
                android:layout_width="90dp"
                android:layout_height="40dp"
                android:text="اعدادات"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                android:background="@android:color/transparent"/>
        </LinearLayout>

        <!-- Connection Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الاتصال بالطابعة"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvDeviceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="غير متصل"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="4dp"/>

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnConnect"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="بلوتوث"
                    android:backgroundTint="#E94560"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnConnectWifi"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="WiFi"
                    android:backgroundTint="#0077CC"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnConnectWifiDirect"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="WiFi Direct"
                    android:backgroundTint="#007744"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnDisconnect"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="قطع الاتصال"
                android:backgroundTint="#999999"
                android:textColor="#FFFFFF"
                android:visibility="gone"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Text Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نص الطباعة"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <EditText
                android:id="@+id/etText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="اكتب النص هنا..."
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A2E"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:minLines="3"
                android:gravity="top|end"
                android:inputType="textMultiLine"
                android:layout_marginTop="8dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="حجم الخط:"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>

            <Spinner
                android:id="@+id/spinnerFontSize"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="#F5F5F5"
                android:popupBackground="#FFFFFF"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المحاذاة:"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>

            <RadioGroup
                android:id="@+id/rgAlign"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/rbRight"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="يمين"
                    android:textColor="#1A1A2E"
                    android:buttonTint="#E94560"
                    android:checked="true"
                    android:gravity="center"/>

                <RadioButton
                    android:id="@+id/rbCenter"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="وسط"
                    android:textColor="#1A1A2E"
                    android:buttonTint="#E94560"
                    android:gravity="center"/>

                <RadioButton
                    android:id="@+id/rbLeft"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="يسار"
                    android:textColor="#1A1A2E"
                    android:buttonTint="#E94560"
                    android:gravity="center"/>
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <CheckBox
                    android:id="@+id/cbBold"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="غامق"
                    android:textColor="#1A1A2E"
                    android:buttonTint="#E94560"/>

                <CheckBox
                    android:id="@+id/cbUnderline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="تسطير"
                    android:textColor="#1A1A2E"
                    android:buttonTint="#E94560"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrintText"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="طباعة النص"
                android:backgroundTint="#E94560"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Barcode Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="باركود / QR Code"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <!-- حقل الإدخال مع معاينة فورية -->
            <EditText
                android:id="@+id/etBarcodeValue"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:hint="اكتب الرقم أو النص — يتحول باركود فوراً"
                android:textColorHint="#AAAAAA"
                android:textColor="#1A1A2E"
                android:background="#F5F5F5"
                android:padding="12dp"
                android:gravity="end|center_vertical"
                android:inputType="text"
                android:layout_marginTop="8dp"/>

            <!-- معاينة الباركود الفورية -->
            <ImageView
                android:id="@+id/imgBarcodePreview"
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:scaleType="fitCenter"
                android:background="#F5F5F5"
                android:padding="8dp"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <TextView
                android:id="@+id/tvBarcodePreviewValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="#555555"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginTop="4dp"/>

            <!-- نوع الباركود -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="نوع الباركود:"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>

            <Spinner
                android:id="@+id/spinnerBarcodeType"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="#F5F5F5"
                android:popupBackground="#FFFFFF"
                android:layout_marginTop="4dp"/>

            <!-- عدد النسخ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="عدد النسخ:"
                android:textColor="#555555"
                android:textSize="13sp"
                android:layout_marginTop="10dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/btnCopiesDown"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="-"
                    android:textSize="20sp"
                    android:backgroundTint="#E0E0E0"
                    android:textColor="#333333"/>

                <TextView
                    android:id="@+id/tvCopiesCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="1"
                    android:gravity="center"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A2E"/>

                <Button
                    android:id="@+id/btnCopiesUp"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="+"
                    android:textSize="20sp"
                    android:backgroundTint="#E94560"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrintBarcode"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="طباعة باركود"
                android:backgroundTint="#0077CC"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="10dp"
                android:enabled="false"/>
        </LinearLayout>

        <!-- PDF Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طباعة ملف PDF"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <TextView
                android:id="@+id/tvPdfName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="لم يتم اختيار ملف"
                android:textColor="#888888"
                android:textSize="13sp"
                android:layout_marginTop="6dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnPickPdf"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="اختر PDF"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnPrintPdf"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="طباعة PDF"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:enabled="false"/>
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressPdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:indeterminate="true"
                android:visibility="gone"
                android:layout_marginTop="6dp"/>
        </LinearLayout>

        <!-- Image Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طباعة صورة"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/imgPreview"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:scaleType="centerInside"
                android:background="#F5F5F5"
                android:visibility="gone"
                android:layout_marginTop="8dp"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnPickImage"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="اختر صورة"
                    android:backgroundTint="#0077CC"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnRemoveImage"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:text="X"
                    android:backgroundTint="#CCCCCC"
                    android:textColor="#FFFFFF"
                    android:visibility="gone"/>
            </LinearLayout>

            <Button
                android:id="@+id/btnPrintImage"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="طباعة الصورة"
                android:backgroundTint="#0077CC"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:layout_marginTop="8dp"
                android:enabled="false"/>
        </LinearLayout>

        <!-- Quick Actions -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="طباعة سريعة"
                android:textColor="#E94560"
                android:textSize="15sp"
                android:textStyle="bold"/>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnPreviewReceipt"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="معاينة الفاتورة"
                    android:backgroundTint="#FF6B35"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"/>

                <Button
                    android:id="@+id/btnPrintFull"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="طباعة الفاتورة"
                    android:backgroundTint="#E94560"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/btnPrintTest"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="اختبار الطابعة"
                    android:backgroundTint="#0077CC"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp"
                    android:enabled="false"/>

                <Button
                    android:id="@+id/btnCutPaper"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:layout_weight="1"
                    android:text="قطع الورق"
                    android:backgroundTint="#999999"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:enabled="false"/>
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/layoutPrintActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

    </LinearLayout>
</ScrollView>
