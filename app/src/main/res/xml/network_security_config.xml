<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS فقط للأمان — إذا سيرفرك HTTP فقط عدّل هذا -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
